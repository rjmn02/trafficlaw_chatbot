
GROQ_API_KEY="..."

# DB
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpass
POSTGRES_DB=trafficlawdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase: Dashboard → Settings → Database → Connection string → URI → Session mode.
# Use the POOLER host (aws-0-<region>.pooler.supabase.com), NOT db.<ref>.supabase.co.
# Direct db.* hosts are IPv6-only; many Windows networks cannot reach them (error 10053).
SUPABASE_DB_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Optional explicit pooler URL (overrides SUPABASE_DB_URL when set)
# SUPABASE_DB_POOLER_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# Local Docker (docker-compose.yml) — set USE_LOCAL_DB=true in backend/.env
# USE_LOCAL_DB=true
# LOCAL_DATABASE_URL="postgresql://root:rootpass@localhost:5432/trafficlawdb"

# Legacy alias (optional; code reads SUPABASE_DB_URL first)
DATABASE_URL="postgresql://root:rootpass@localhost:5432/trafficlawdb"

DATA_RAW_PATH="[pathname]"
DATA_PROCESSED_PATH="[pathname]"
EVAL_TESTSET_PATH="[pathname]"

# Vite frontend (frontend/.env — copy from frontend/.env.example)
# Dev: leave VITE_API_URL unset; Vite proxies /api/* to Python
# Prod (Vercel): set at build time to your Render backend URL (no trailing slash)
# VITE_API_URL="https://your-service.onrender.com"

# Python backend — local dev default
PYTHON_API_URL="http://127.0.0.1:8000"

# Security Configuration (CRITICAL FOR PRODUCTION)
# Comma-separated list of allowed origins for CORS on the Python backend
#
# For development: Leave commented (defaults include localhost:5173 for Vite)
# For production: Set on Render — REQUIRED! Include your Vercel URL(s).
#
# Example for Vercel + Render:
# ALLOWED_ORIGINS="https://your-app.vercel.app,https://your-app-git-main.vercel.app"
#
# Development (optional — already default in backend/main.py):
# ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"